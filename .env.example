# Copie para .env.local e preencha. Nunca commite o .env.local.
# Sem MP_ACCESS_TOKEN, o app usa o pagamento e o saque simulados (Parte A).

# ---------------------------------------------------------------- Mercado Pago
# Painel: https://www.mercadopago.com.br/developers/panel > aplicação > Credenciais.
# Use as credenciais de TESTE até a integração estar validada.

# Access Token: só no servidor. Dá acesso total à conta; nunca expor no navegador.
MP_ACCESS_TOKEN=

# Public Key: vai para o navegador (formulário de cartão do Mercado Pago). Não é segredo.
NEXT_PUBLIC_MP_PUBLIC_KEY=

# Chave secreta do webhook: em Webhooks > Configurar notificações, evento "Order (Mercado Pago)",
# URL https://<domínio>/api/webhooks/mercadopago. Sem ela, todo webhook é recusado.
MP_WEBHOOK_SECRET=

# "teste" ou "producao". Em produção o saque (Payouts) fica bloqueado até implementarmos a
# assinatura exigida pelo Mercado Pago.
MP_AMBIENTE=teste

# ---------------------------------------------------------------- Login com Google
# Google Cloud Console > APIs e serviços > Credenciais > ID do cliente OAuth (aplicativo da Web).
# URI de redirecionamento autorizado: {APP_URL}/api/auth/google/callback
# Sem estas três, o botão do Google não aparece e só vale e-mail e senha.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Endereço público do site, sem barra no fim (ex.: http://localhost:3000 ou https://clicouai.vercel.app).
# Também monta o link e o QR Code de divulgação dos eventos: em produção, precisa ser o domínio real.
APP_URL=http://localhost:3000

# E-mails que entram como gestores (painel /admin) ao fazer login com o Google, separados por vírgula.
ADMIN_EMAILS=

# ---------------------------------------------------------------- Reconhecimento facial
# Amazon Rekognition. Sem estas variáveis, a busca por selfie usa os rostos dos dados de exemplo.
# O usuário IAM precisa só das permissões rekognition:CreateCollection, IndexFaces e
# SearchFacesByImage. Confira a região: a selfie é dado biométrico (LGPD).
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Prefixo das coleções de rostos (uma por evento: {prefixo}-{id do evento}).
REKOGNITION_PREFIXO=clicouai

# ---------------------------------------------------------------- Segredo do app
# Assina dados que o servidor entrega ao navegador e confere depois (ex.: as fotos encontradas
# pela busca, que dão direito ao preço do pacote). Obrigatório em produção, com 32 caracteres
# ou mais. Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Sem ele, em desenvolvimento, usa uma chave aleatória que muda a cada reinício do servidor.
APP_SECRET=
