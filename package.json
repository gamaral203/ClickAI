    "@base-ui/react": "^1.8.0",
    "@electric-sql/pglite": "^0.5.8",
    "@sentry/nextjs": "^11.5.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.3",
    "heic-to": "1.6.5",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.52.0",
    "motion": "^14.1.0",
    "next": "16.4.0",
    "otpauth": "^9.5.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
